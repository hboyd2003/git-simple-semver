# Java sources
*.java                                     text diff=java
*.kt                                       text diff=kotlin
*.groovy                                   text diff=java
*.scala                                    text diff=java
*.gradle                                   text diff=java
*.gradle.kts                               text diff=kotlin
src/java/resources/META-INF/services/**    text

# Text files
*.txt             text
*.css             text diff=css
*.scss            text diff=css
*.sass            text
*.df              text
*.htm             text diff=html
*.html            text diff=html
*.js              text
*.mjs             text
*.cjs             text
*.jsp             text
*.jspf            text
*.jspx            text
*.properties      text
*.tld             text
*.tag             text
*.tagx            text
*.xml             text
*.toml            text
*.yaml            text
*.yml             text
*.md              text
.gitattributes    text
.gitignore        text

# Build Tools
gradlew         text eol=lf

# These files are binary and should be left untouched
# (binary is a macro for -text -diff)
*.class         binary
*.dll           binary
*.ear           binary
*.jar           binary
*.so            binary
*.war           binary
*.jks           binary

# These are explicitly windows files and should use crlf
*.bat           text eol=crlf
